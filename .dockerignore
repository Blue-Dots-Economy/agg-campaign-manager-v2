# Keep the build context small and stop host artefacts leaking into the image.
.git
.github
node_modules
dist
.output
.vinxi
.wrangler
.tanstack
.nitro
*.log
.DS_Store
.vscode
.idea

# Not read by the build. Excluding them keeps them out of the context and stops
# an edit to one of them invalidating the `COPY . .` layer and rebuilding.
.lovable
supabase
*.md
sonar-project.properties
eslint.config.js
.prettierrc
.prettierignore
Dockerfile
.dockerignore
# Helm chart (PR #2): deployment config, not image input.
campaign-manager
global-overrides.yaml

# NOT ignored on purpose: `.env`. The client bundle's VITE_SUPABASE_* values are
# read from it at build time (see Dockerfile). It never reaches the runtime stage,
# which receives only .output.
